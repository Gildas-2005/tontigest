# ============================================================
# TontiGest — Configuration
# Copiez ce fichier en ".env" puis renseignez vos clés.
# Tant qu'une clé manque, la fonctionnalité reste en mode simulation
# honnête (clairement affichée dans l'application).
# ============================================================

# ---------- Serveur HTTP ----------
PORT=8787

# ---------- Base de données MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tontigest

# ---------- Sécurité JWT ----------
# Générez un secret long :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=tontigest-secret-local-dev-key-change-me
JWT_EXPIRES=7d

# ---------- Compte superadmin (créé au premier démarrage) ----------
SUPERADMIN_EMAIL=admin@tontigest.cm
SUPERADMIN_PASSWORD=

# ---------- PAIEMENTS — GeniusPay CI ----------
# Documentation : https://geniuspay.ci/docs/api | Dashboard : geniuspay.ci/dashboard
# SANDBOX : clés pk_sandbox_…/sk_sandbox_… + GENIUSPAY_SANDBOX=true (aucun argent réel).
# Production : clés pk_live_…/sk_live_… + GENIUSPAY_SANDBOX=false.
GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_SANDBOX=true

# ---------- NOTIFICATIONS EMAIL — Mailjet ----------
# https://app.mailjet.com/account/apikeys
# Récupérez la clé API ET la clé secrète (toutes les deux sur cette page).
# MAILJET_SENDER_EMAIL doit être un expéditeur validé dans Mailjet.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=TontiGest

# ---------- NOTIFICATIONS SMS — Twilio (optionnel) ----------
# console.twilio.com → achetez un numéro (~1,15 $/mois) → Account SID + Auth Token.
# Sert aux SMS de secours et au 2FA par SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- PUSH WEB — VAPID (aucun compte requis) ----------
# Générez les clés localement : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@tontigest.cm
